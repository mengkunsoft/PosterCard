# 依赖（本项目依赖已内置在 assets/vendor/，一般无需安装；若本地安装则忽略）
node_modules/

# npm 锁文件（本项目运行时依赖均已内置，仅构建用；如需 CI 可复现可改为提交）
package-lock.json

# 构建产物（dist/ 由 CI 构建后提交回仓库，需纳入版本控制；build/ 为本地临时目录仍忽略）
build/
*.log

# 插件打包产物：dist/tpl/assets 由 build-plugins.js 复制进插件目录，发布时随 zip 打包，不入库
# （保留 wordpress 插件的源文件 assets/init.js，仅忽略复制进来的 vendor/ 与占位图）
plugins/*/postercard/dist/
plugins/*/postercard/tpl/
plugins/*/postercard/assets/vendor/
plugins/*/postercard/assets/postercard.webp

# 插件发布 zip（release 时由 CI 生成并作为 Release 资源）
releases/

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*~

.codebuddy